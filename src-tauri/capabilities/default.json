{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-background-color",
    "core:window:allow-set-effects",
    "deep-link:default",
    "dialog:allow-open"
  ]
}
