{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cloudburst Dev",
  "mainBinaryName": "cloudburst-dev",
  "identifier": "dev.vitroid.cloudburst.dev",
  "build": {
    "beforeBuildCommand": "pnpm generate --envName development"
  },
  "app": {
    "windows": [
      {
        "title": "Cloudburst Dev",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        },
        "dragDropEnabled": false
      }
    ]
  }
}
