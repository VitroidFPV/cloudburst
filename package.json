{
  "name": "cloudburst",
  "version": "0.2.0",
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "nuxt build",
    "build:desktop": "pnpm build:desktop:production",
    "build:desktop:dev": "tauri build --debug --config src-tauri/tauri.dev.conf.json",
    "build:desktop:production": "tauri build",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "release:check": "node scripts/check-version.mjs",
    "release:prepare": "node scripts/set-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "tauri": "tauri"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@nuxt/ui": "^4.11.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@tauri-apps/cli": "^2.11.4",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.6"
  }
}
